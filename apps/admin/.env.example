# Copy to .env.local and change both values.
ADMIN_PASSWORD=change-me
# Any long random string (at least 16 characters); used to sign the admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Public website URL, used for the "View site" link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where content.json and uploads/ live. Defaults to <repo>/storage.
# KAIZEN_STORAGE_DIR=/var/data/kaizen
