# Uploaded images and PDFs are served as plain files. Nothing in here may run as a script or render as a page.
Options -Indexes
<FilesMatch "\.(php\d?|phtml|phar|pht|pl|py|cgi|sh|s?html?|svgz?|js|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=2592000"
</IfModule>
