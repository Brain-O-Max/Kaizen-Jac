# The helper library and generated settings are only included by the other scripts, never opened directly.
<FilesMatch "^(_lib|config)\.php$|^\.user\.ini$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
