# Copy to .env.local for local development. On Hostinger, add these under the app's Environment variables.

# Password for /admin
ADMIN_PASSWORD=change-me
# Any long random string (at least 16 characters); used to sign the admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Where content.json, uploads/ and inquiries/ are stored. Defaults to ./storage.
# In production use an absolute path OUTSIDE the deployed app folder, e.g. /home/<user>/kaizen-storage
# KAIZEN_STORAGE_DIR=
