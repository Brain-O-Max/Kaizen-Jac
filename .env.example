# Local development: copy to .env.local.
# Building upload packages for the live sites: copy to .env.production.local and fill in the real values.

# Admin password. ADMIN_PASSWORD is used by every site unless a site-specific one is set.
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_ENTERPRISE=
# ADMIN_PASSWORD_DESIGN=
# ADMIN_PASSWORD_TRAINING=

# Where contact-form inquiries are emailed. Empty = the contact email saved in that site's admin.
# INQUIRY_EMAIL=
# INQUIRY_EMAIL_ENTERPRISE=
# INQUIRY_EMAIL_DESIGN=
# INQUIRY_EMAIL_TRAINING=

# Public address of each site. Used for the footer links between the companies and for SEO.
# Defaults are the local development addresses.
# SITE_URL_ENTERPRISE=https://kaizenenterprise.com
# SITE_URL_DESIGN=https://design.kaizenenterprise.com
# SITE_URL_TRAINING=https://training.kaizenenterprise.com

# Local development only: address of `npm run php` if you changed its port.
# PHP_DEV_URL=http://127.0.0.1:8080
