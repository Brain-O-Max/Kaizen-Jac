# Copy to .env.local for local development. On Hostinger, add these under each app's Environment variables.

# Which website this deployment serves: enterprise | design | training
# (the dev:* npm scripts set this for you; plain `npm run dev` uses enterprise)
# SITE=enterprise

# Password for /admin
ADMIN_PASSWORD=change-me
# Any long random string (at least 16 characters); used to sign the admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Public address of each site. Used for the footer links between the companies and for SEO.
# Set all three on every deployment. Defaults are the local development addresses.
# SITE_URL_ENTERPRISE=https://kaizenenterprise.com
# SITE_URL_DESIGN=https://design.kaizenenterprise.com
# SITE_URL_TRAINING=https://training.kaizenenterprise.com

# Where this site's content.json, uploads/ and inquiries/ are stored. Defaults to ./storage/<site>.
# In production use an absolute path OUTSIDE the deployed app folder, different for each site,
# e.g. /home/<user>/kaizen-storage-enterprise
# KAIZEN_STORAGE_DIR=
