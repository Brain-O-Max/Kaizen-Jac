{
  "name": "kaizen-jac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:enterprise": "cross-env SITE=enterprise NEXT_DIST_DIR=.next-enterprise next dev --port 3000",
    "dev:design": "cross-env SITE=design NEXT_DIST_DIR=.next-design next dev --port 3001",
    "dev:training": "cross-env SITE=training NEXT_DIST_DIR=.next-training next dev --port 3002",
    "php": "php -S 127.0.0.1:8080 php/dev-router.php",
    "dev:all": "concurrently -n php,enterprise,design,training -c gray,teal,blue,yellow \"npm:php\" \"npm:dev:enterprise\" \"npm:dev:design\" \"npm:dev:training\"",
    "build": "next build",
    "package:enterprise": "node scripts/package.mjs enterprise",
    "package:design": "node scripts/package.mjs design",
    "package:training": "node scripts/package.mjs training",
    "package:all": "node scripts/package.mjs all",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
